
@model List<Book>

@{
    ViewData["Title"] = "Books";
}

<!-- PAGE HEADER -->
<section class="catalogue-header">
    <div>
        <span class="section-eyebrow">THE LITTLE LIBRARY / COLLECTION</span>
        <h1 class="mb-2">Our Bookshelf</h1>
        <p class="text-muted mb-0">
            Every book has a story. Find the next one worth reading.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <span>+</span> Add a Book
    </a>
</section>

<!-- CATALOGUE SUMMARY -->
<section class="catalogue-summary">
    <div class="catalogue-summary-icon">▤</div>
    <div>
        <span class="summary-label">TOTAL COLLECTION</span>
        <h2>@Model.Count <span>books</span></h2>
    </div>
    <div class="summary-note">
        Your collection, all in one place.
    </div>
</section>

<!-- SEARCH AND FILTER -->
<section class="catalogue-toolbar">
    <div class="catalogue-search">
        <span class="search-icon">⌕</span>
        <input type="search"
               id="bookSearch"
               class="form-control"
               placeholder="Search by title or category..."
               aria-label="Search books by title or category" />
    </div>

    <span class="catalogue-hint">Browse your collection</span>
</section>

<!-- BOOKS TABLE -->
<section class="catalogue-table-section">
    <div class="catalogue-table-heading">
        <div>
            <h2>Book Catalogue</h2>
            <p class="text-muted mb-0">Manage your titles and book details.</p>
        </div>
        <span class="catalogue-count">@Model.Count entries</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle catalogue-table">
            <thead>
                <tr>
                    <th class="text-end" style="width: 5rem;">ID</th>
                    <th>Book Title</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end" style="width: 11rem;">Actions</th>
                </tr>
            </thead>

            <tbody id="bookTableBody">
                @foreach (var book in Model)
                {
                    <tr class="book-row">
                        <td class="text-end book-id">
                            @book.BookId
                        </td>

                        <td>
                            <div class="book-title-cell">
                                <span class="book-mini-icon">▤</span>
                                <span class="book-title-text">@book.Title</span>
                            </div>
                        </td>

                        <td>
                            <span class="badge text-bg-secondary book-category">
                                @(book.Category ?? "Uncategorized")
                            </span>
                        </td>

                        <td class="text-end book-price">
                            @(book.Price?.ToString("N2") ?? "—")
                        </td>

                        <td class="text-end">
                            <div class="book-actions">
                                <a asp-action="Edit"
                                   asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                <tr id="noBooksFound" style="display: none;">
                    <td colspan="5" class="text-center py-5">
                        <div class="empty-state-icon">⌕</div>
                        <h3>No books found</h3>
                        <p class="text-muted mb-0">
                            Try searching with another title or category.
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="catalogue-table-footer">
        <span id="visibleBookCount">
            Showing @Model.Count books
        </span>

        <a asp-action="Create" class="catalogue-add-link">
            Add another book <span>→</span>
        </a>
    </div>
</section>

<!-- BOTTOM NOTE -->
<section class="catalogue-bottom-note">
    <span class="bottom-note-icon">✳</span>
    <p>
        <strong>A little reminder:</strong>
        Every great reading journey starts with a single book.
    </p>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("bookSearch");
            const rows = document.querySelectorAll(".book-row");
            const emptyRow = document.getElementById("noBooksFound");
            const visibleCount = document.getElementById("visibleBookCount");
            const totalCount = rows.length;

            function filterBooks() {
                const query = searchInput.value.trim().toLowerCase();
                let visible = 0;

                rows.forEach(function (row) {
                    const title = row.querySelector(".book-title-text")
                        .textContent.toLowerCase();

                    const category = row.querySelector(".book-category")
                        .textContent.toLowerCase();

                    const matches =
                        title.includes(query) || category.includes(query);

                    row.style.display = matches ? "" : "none";

                    if (matches) {
                        visible++;
                    }
                });

                emptyRow.style.display = visible === 0 ? "" : "none";

                visibleCount.textContent =
                    "Showing " + visible + " of " + totalCount + " books";
            }

            searchInput.addEventListener("input", filterBooks);
        });
    </script>
}
