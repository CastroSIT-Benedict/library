
@model List<LoanView>

@{
    ViewData["Title"] = "Loans";
}

<div class="loans-page">

    <!-- PAGE HEADER -->
    <section class="loans-header">
        <div>
            <span class="section-eyebrow">THE LITTLE LIBRARY / LENDING</span>
            <h1>Loan Records</h1>
            <p class="text-muted mb-0">
                Keep track of borrowed books, due dates, and returns.
            </p>
        </div>

        <a asp-action="Borrow" class="btn btn-primary">
            <span>+</span> Borrow a Book
        </a>
    </section>

    <!-- LOAN SUMMARY -->
    <section class="loans-summary">
        <div class="loans-summary-icon">▤</div>

        <div>
            <span class="summary-label">TOTAL LOAN RECORDS</span>
            <h2>@Model.Count <span>loans</span></h2>
        </div>

        <div class="summary-note">
            All borrowing activity in one place.
        </div>
    </section>

    <!-- LOAN TABLE -->
    <section class="loans-table-section">

        <div class="loans-table-heading">
            <div>
                <h2>Loan History</h2>
                <p class="text-muted mb-0">
                    Newest borrowing records appear first.
                </p>
            </div>

            <span class="catalogue-count">@Model.Count entries</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle loans-table">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Book</th>
                        <th>Loaned</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td class="loan-member">
                                @loan.MemberName
                            </td>

                            <td class="loan-book">
                                @loan.BookTitle
                            </td>

                            <td class="loan-date">
                                @loan.LoanedOn.ToString("yyyy-MM-dd")
                            </td>

                            <td class="loan-date">
                                @loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                <span class="loan-status @(loan.Status == "Overdue" ? "status-overdue" : loan.Status == "Out" ? "status-out" : "status-returned")">
                                    @loan.Status
                                </span>
                            </td>

                            <td class="text-end">
                                @if (loan.ReturnedOn == null)
                                {
                                    <form asp-action="Return"
                                          asp-route-id="@loan.LoanId"
                                          method="post"
                                          class="loan-return-form">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Return
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="loan-completed">Completed</span>
                                }
                            </td>
                        </tr>
                    }

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="empty-state-icon">▤</div>
                                <h3>No loan records yet</h3>
                                <p class="text-muted mb-3">
                                    Borrow a book to create your first loan record.
                                </p>
                                <a asp-action="Borrow" class="btn btn-primary">
                                    Borrow a Book
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="loans-table-footer">
            <span>Showing @Model.Count loan records</span>

            <a asp-action="Borrow" class="catalogue-add-link">
                Create a new loan <span>→</span>
            </a>
        </div>

    </section>

    <!-- BOTTOM NOTE -->
    <section class="catalogue-bottom-note">
        <span class="bottom-note-icon">✳</span>
        <p>
            <strong>A little reminder:</strong>
            Every borrowed book deserves a safe return.
        </p>
    </section>

</div>
